{
  "info": {
    "name": "UnivalleShop · seis servicios y React",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3200"
    }
  ],
  "item": [
    {
      "name": "1 Crear perfil temporal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Univalle\",\n  \"email\": \"demo{{$randomInt}}@correounivalle.edu.co\",\n  \"password\": \"{{$randomPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Respuesta exitosa\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "pm.collectionVariables.set(\"userId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2 Publicar producto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cuaderno de cálculo\",\n  \"price\": 12500,\n  \"stock\": 5\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Respuesta exitosa\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "pm.collectionVariables.set(\"productId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3 Buscar con acentos y precio",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/search?q=CÁLCULO&maxPrice=15000"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Respuesta exitosa\", () => pm.expect(pm.response.code).to.be.within(200, 299));"
            ]
          }
        }
      ]
    },
    {
      "name": "4 Guardar intereses",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/recommendations/{{userId}}/preferences",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"keywords\": [\n    \"cálculo\",\n    \"cuaderno\"\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Respuesta exitosa\", () => pm.expect(pm.response.code).to.be.within(200, 299));"
            ]
          }
        }
      ]
    },
    {
      "name": "5 Ver recomendaciones",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/recommendations/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Respuesta exitosa\", () => pm.expect(pm.response.code).to.be.within(200, 299));"
            ]
          }
        }
      ]
    },
    {
      "name": "6 Crear pedido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Respuesta exitosa\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "pm.collectionVariables.set(\"orderId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "7 Pago simulado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/payments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"idempotencyKey\": \"postman_{{orderId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Respuesta exitosa\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "pm.collectionVariables.set(\"paymentId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "8 Consultar comprobante",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/payments/{{paymentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Respuesta exitosa\", () => pm.expect(pm.response.code).to.be.within(200, 299));"
            ]
          }
        }
      ]
    },
    {
      "name": "9 Repetir pago sin duplicarlo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/payments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"idempotencyKey\": \"postman_{{orderId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Respuesta exitosa\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "pm.test(\"Misma transacción\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"paymentId\")));"
            ]
          }
        }
      ]
    }
  ]
}
