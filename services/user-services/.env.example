# Copia este archivo a .env y completa los valores.
#   cp .env.example .env

# NestJS Observe (https://observe.nestjs.com)
# Genera tu propio par de llaves con: npx @nestjs/observe link
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Conexión a MongoDB (mongodb://usuario:password@host:27017/univalle_shop)
MONGODB_URI=

# Puerto HTTP del servidor (por defecto 3000)
PORT=3000
